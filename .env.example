# Set this only in a local .env file or the runtime environment.
DASHSCOPE_API_KEY=sk-your-key-here
ROS_DOMAIN_ID=99
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Official RGB-D Image.frame_id is head_camera. Leave this at the default unless
# the Server's image frame changes.
MATERIAL_HEAD_CAMERA_FRAME=head_camera
# Temporary debug override only. Normal operation derives dynamic MJCF extrinsics.
MATERIAL_CAMERA_TO_BASE=
MATERIAL_WORLD_FRAME=odom
MATERIAL_ACTION_TIMEOUT=90
MATERIAL_NAV_TIMEOUT=35
